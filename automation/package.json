{
  "name": "sreeraj-dev-redesign-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated monthly website redesign system for sreeraj.dev",
  "scripts": {
    "redesign": "tsx redesign-orchestrator.ts",
    "redesign:dry": "tsx redesign-orchestrator.ts --dry-run",
    "generate": "tsx design-generator.ts",
    "validate": "tsx validate-design.ts",
    "layout:check": "tsx layout-geometry.ts",
    "layout:qa": "tsx layout-qa-stage.ts",
    "probe": "tsx pipeline/probe.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --import tsx --test pipeline/*.test.ts",
    "build:site": "cd .. && npm run build",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:hard": "playwright test -c e2e/playwright.config.ts --grep @hard"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "playwright": "^1.49.0",
    "serve": "^14.2.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.58.2"
  }
}
