---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<BaseLayout title="Tags — sreeraj.dev" description="Every tag on sreeraj.dev." theme="tech">
  <header class="page-poster">
    <div class="wrap page-poster-grid">
      <div>
        <span class="stamp">Taxonomy</span>
        <h1 class="page-title">Every tag</h1>
        <p class="page-description">
          {tags.length} tags across {posts.length} dispatches, largest first.
        </p>
      </div>
      <div class="count-stamp" aria-hidden="true">
        <strong>{String(tags.length).padStart(2, '0')}</strong>
        <span>tags</span>
      </div>
    </div>
  </header>

  <section class="wrap sec" aria-label="All tags">
    <ul class="tag-wall">
      {tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`} class="tag-pill">
            <span>{tag}</span>
            <span class="n">{String(count).padStart(2, '0')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
