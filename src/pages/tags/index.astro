---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const total = String(sortedTags.length).padStart(2, '0');
---

<BaseLayout title="Tags — sreeraj.dev" description="Browse every topic." theme="tech">
  <section class="container" style="padding-top: clamp(3rem, 7vw, 5rem); padding-bottom: clamp(4rem, 9vw, 7rem);">
    <div class="grid-12" style="align-items: end;">
      <div style="grid-column: span 9;" class="max-md:!col-span-12">
        <span class="kicker">Taxonomy</span>
        <h1 class="page-title" style="font-size: var(--fs-2xl); font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; margin-top: 1.1rem;">Tags</h1>
      </div>
      <div style="grid-column: span 3;" class="max-md:!col-span-12 md:text-right">
        <span style="font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6;">Topics</span>
        <div style="font-size: var(--fs-2xl); font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--color-accent);">{total}</div>
      </div>
    </div>

    <div class="rule" style="margin-top: 2rem; margin-bottom: 2.5rem;"></div>

    <div class="flex flex-wrap" style="gap: 0.75rem;">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}/`} class="tag-pill inline-flex items-baseline transition-colors" style="padding: 0.5rem 0.9rem; gap: 0.5rem; font-size: var(--fs-sm);">
          {tag}
          <span style="font-size: var(--fs-2xs); opacity: 0.6;">{String(count).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
