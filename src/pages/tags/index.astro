---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<BaseLayout title="tags — sreeraj.dev" description="Every tag on sreeraj.dev." theme="tech">
  <div class="band">
    <div class="cell label-cell cell--yellow c3">
      <span>taxonomy /</span>
    </div>
    <div class="cell c7">
      <h1 class="page-title">every tag</h1>
      <p class="section-sub">{tags.length} tags across {posts.length} compositions</p>
    </div>
    <div class="plane plane--blue c2" aria-hidden="true"></div>
  </div>

  <div style="display: flex; flex-wrap: wrap; gap: var(--line); background: var(--ink);">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${tag}/`} class="tag-cell" style="flex: 1 1 180px;">
        <span>{tag}</span>
        <span class="n">{count} {count === 1 ? 'post' : 'posts'}</span>
      </a>
    ))}
  </div>
</BaseLayout>
