---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getThemeForTags } from '../utils/theme';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prevPost:
        i < posts.length - 1
          ? { slug: posts[i + 1].data.slug, title: posts[i + 1].data.title }
          : null,
      nextPost:
        i > 0 ? { slug: posts[i - 1].data.slug, title: posts[i - 1].data.title } : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const theme = getThemeForTags(post.data.tags);
---

<PostLayout
  title={post.data.title}
  slug={post.data.slug}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  featureImage={post.data.featureImage}
  tags={post.data.tags}
  author={post.data.author}
  readingTime={post.data.readingTime}
  theme={theme}
  prevPost={prevPost}
  nextPost={nextPost}
  trekStats={post.data.trekStats}
>
  <Content />
</PostLayout>
