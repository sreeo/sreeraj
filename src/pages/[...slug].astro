---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getThemeForTags } from '../utils/theme';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const i = all.findIndex((p) => p.data.slug === post.data.slug);
// all[] is newest-first: prev = older entry, next = newer entry
const prevPost = i < all.length - 1 ? { slug: all[i + 1].data.slug, title: all[i + 1].data.title } : null;
const nextPost = i > 0 ? { slug: all[i - 1].data.slug, title: all[i - 1].data.title } : null;
---

<PostLayout
  title={post.data.title}
  slug={post.data.slug}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  featureImage={post.data.featureImage}
  tags={post.data.tags}
  author={post.data.author}
  readingTime={post.data.readingTime}
  theme={getThemeForTags(post.data.tags)}
  prevPost={prevPost}
  nextPost={nextPost}
  trekStats={post.data.trekStats}
>
  <Content />
</PostLayout>
