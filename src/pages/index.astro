---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Composition from '../components/Composition.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { spanFor } from '../utils/spans';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const feat = posts.filter((p) => p.data.featured)[0] ?? posts[0];
const rest = posts;
const total = posts.length;

const has = (p: (typeof posts)[number], ...names: string[]) =>
  names.some((n) => p.data.tags.includes(n));

const cats = [
  { name: 'devops', href: '/devops/', paint: 'red', n: posts.filter((p) => has(p, 'devops')).length },
  { name: 'postgres', href: '/postgres/', paint: 'blue', n: posts.filter((p) => has(p, 'postgres')).length },
  { name: 'programming', href: '/programming/', paint: 'yellow', n: posts.filter((p) => has(p, 'programming')).length },
  { name: 'treks', href: '/treks/', paint: 'ink', n: posts.filter((p) => has(p, 'treks', 'trek')).length },
];

const featNo = String(total - posts.indexOf(feat)).padStart(3, '0');
const firstYear = Math.min(...posts.map((p) => p.data.pubDate.getUTCFullYear()));
---

<BaseLayout title="sreeraj.dev — devops, postgres, programming & treks" theme="tech">
  <h1 class="sr-only">sreeraj.dev — devops, postgres, programming and himalayan treks</h1>

  <!-- ============ the master composition ============ -->
  <section class="hero-band" aria-label="Featured">
    <div class="hero-plr plane plane--red" aria-hidden="true"></div>

    <div class="cell hero-feat">
      <div>
        <p class="feat-label">featured composition — no. {featNo}</p>
        <h2 class="feat-title">
          <a href={`/${feat.data.slug}/`}>{feat.data.title}</a>
        </h2>
        {feat.data.description && <p class="feat-desc">{feat.data.description}</p>}
      </div>
      <a href={`/${feat.data.slug}/`} class="feat-go">
        read the piece
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="hero-stmt">
      <p class="stmt-kicker">composition 2026 &middot; 09</p>
      <p class="stmt-text">
        devops, postgres, programming &amp; the himalaya — a blog arranged in
        pure horizontals and verticals.
      </p>
      <p class="stmt-counts">{total} posts &middot; 4 sections &middot; since {firstYear}</p>
    </div>

    <Composition />

    <nav class="hero-cats" aria-label="Sections">
      {cats.map((c) => (
        <a href={c.href} class="cat-cell" data-paint={c.paint}>
          <span class="cat-mark" aria-hidden="true"></span>
          <span class="cat-name">{c.name}</span>
          <span class="cat-n">{c.n} posts</span>
        </a>
      ))}
    </nav>

    <div class="hero-plb plane plane--blue" aria-hidden="true"></div>
  </section>

  <!-- ============ the index ============ -->
  <section class="band" aria-label="All posts">
    <div class="cell c8">
      <h2 class="section-title">the index</h2>
      <p class="section-sub">
        all {total} compositions, newest first — last published
        <FormattedDate date={posts[0].data.pubDate} />
      </p>
    </div>
    <div class="plane plane--yellow c1" aria-hidden="true"></div>
    <div class="plane plane--white c2" aria-hidden="true"></div>
    <div class="plane plane--red c1" aria-hidden="true"></div>

    {rest.map((post, i) => (
      <PostCard
        title={post.data.title}
        slug={post.data.slug}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        readingTime={post.data.readingTime}
        num={String(total - i).padStart(3, '0')}
        span={spanFor(i)}
      />
    ))}
  </section>
</BaseLayout>
