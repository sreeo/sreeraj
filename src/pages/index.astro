---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Goblet from '../components/Goblet.astro';
import Device from '../components/Device.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SECTIONS, VARIA, sectionFor } from '../utils/sections';
import { plainText, trimWords } from '../utils/text';
import { roman } from '../utils/roman';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.filter((p) => p.data.featured);
const lead = featured[0] ?? posts[0];
const leadSection = sectionFor(lead.data.tags);

// Chapter numbers run in order of printing, oldest first.
const numOf = (slug: string) => posts.length - posts.findIndex((p) => p.data.slug === slug);

// The goblet: the lead work's description and its opening, ~520 characters.
const opening = plainText(`${lead.data.description} ${lead.body ?? ''}`);
const gobletText = trimWords(opening, 560).replace(/[^.!?]$/, (c) => c + '.');

// The Tabula: every work under exactly one rubric, the miscellany last.
const groups = [...SECTIONS, VARIA]
  .map((s) => ({
    section: s,
    posts: posts.filter((p) => (sectionFor(p.data.tags)?.name ?? 'varia') === s.name),
  }))
  .filter((g) => g.posts.length > 0);

// Split the groups across the verso and recto of the second spread.
const half = posts.length / 2;
let running = 0;
const verso: typeof groups = [];
const recto: typeof groups = [];
for (const g of groups) {
  (running < half - 1 ? verso : recto).push(g);
  running += g.posts.length;
}
const catchword = recto[0]?.section.rubric ?? '';
const year = roman(new Date().getUTCFullYear());
---

<BaseLayout
  title="sreeraj.dev — the notebooks of Sreeraj Rajan"
  description="DevOps, Postgres, programming and Himalayan treks — set as a Venetian book of 1499."
  ground="field"
  runningTitle="Opera omnia"
>
  <section class="spread" aria-label="Title page">
    <div class="spread-inner">
      <div class="leaf leaf--verso">
        <div class="title-page">
          <span class="tp-kicker sc">Opera omnia · editio Aldina</span>
          <h1 class="tp-title">Sreeraj<span class="dot">·</span>dev</h1>
          <Goblet
            class="tp-sub goblet--italic"
            shape="funnel"
            end=""
            text="Being the notebooks of Sreeraj Rajan, on DevOps, Postgres and the craft of programming, with certain journeys among the mountains"
          />
          <Device class="tp-device" title="The printer's device: an anchor and dolphin, the dolphin coiled as an S" />
          <p class="tp-imprint sc">
            Impressum in officina Sreeraj, {year}
            <span>{posts.length} works in {SECTIONS.length} books and a miscellany</span>
          </p>
        </div>
        <div class="leaf-foot" aria-hidden="true">
          <span class="catch">Proœmium</span>
        </div>
      </div>

      <div class="leaf leaf--recto">
        <article class="proem">
          <span class="liber sc">Proœmium</span>
          <h2 class="proem-title"><a href={`/${lead.data.slug}/`}>{lead.data.title}</a></h2>
          <div class="proem-meta sc">
            <FormattedDate date={lead.data.pubDate} format="long" />
            <span class="sep" aria-hidden="true">·</span>
            {leadSection?.rubric ?? 'Varia'}
            <span class="sep" aria-hidden="true">·</span>
            Lectio {lead.data.readingTime} min
          </div>
          <Goblet text={gobletText} shape="goblet" lead={2} />
          <a class="proem-more ruled" href={`/${lead.data.slug}/`}>Read the whole treatise &rarr;</a>
        </article>
        <div class="leaf-foot" aria-hidden="true">
          <span class="sigmark">a.ii</span>
          <span class="catch">Tabula</span>
        </div>
      </div>
    </div>
  </section>

  <section class="spread" aria-labelledby="tabula-title">
    <div class="spread-inner" data-qa="post-list">
      <div class="leaf leaf--verso">
        <header class="tabula-head">
          <span class="liber sc">Index</span>
          <h2 class="page-title" id="tabula-title">Tabula</h2>
          <p>of the works contained in this volume, by book</p>
        </header>
        {verso.map((g) => (
          <div class="tabula-group">
            <h3 class="tabula-rubric">
              {g.section.name === 'varia' ? <span>{g.section.rubric}</span> : <a href={g.section.href}>{g.section.rubric}</a>}
              <small>{g.section.liber}</small>
            </h3>
            <ol class="git-log-timeline">
              {g.posts.map((p) => (
                <li class="gl-entry">
                  <PostCard title={p.data.title} slug={p.data.slug} pubDate={p.data.pubDate} tags={p.data.tags} num={numOf(p.data.slug)} />
                </li>
              ))}
            </ol>
          </div>
        ))}
        <div class="leaf-foot" aria-hidden="true">
          <span class="sigmark">a.iii</span>
          <span class="catch">{catchword}</span>
        </div>
      </div>

      <div class="leaf leaf--recto">
        {recto.map((g) => (
          <div class="tabula-group">
            <h3 class="tabula-rubric">
              {g.section.name === 'varia' ? <span>{g.section.rubric}</span> : <a href={g.section.href}>{g.section.rubric}</a>}
              <small>{g.section.liber}</small>
            </h3>
            <ol class="git-log-timeline">
              {g.posts.map((p) => (
                <li class="gl-entry">
                  <PostCard title={p.data.title} slug={p.data.slug} pubDate={p.data.pubDate} tags={p.data.tags} num={numOf(p.data.slug)} />
                </li>
              ))}
            </ol>
          </div>
        ))}
        <p class="tabula-sum">
          The works are numbered in the order they were printed. Every rubric is
          gathered in the <a class="ruled" href="/tags/">Index rerum</a>; past
          editions of this book are kept in the <a class="ruled" href="/archive/">Catalogus</a>.
        </p>
        <span class="fleuron" aria-hidden="true">❧</span>
        <div class="leaf-foot" aria-hidden="true">
          <span class="sigmark">a.iiii</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
