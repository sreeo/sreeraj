---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Device from '../../components/Device.astro';
import registryData from '../../../public/archive/registry.json';
import { roman } from '../../utils/roman';

const archives = registryData.archives || [];
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const yearOf = (month: string) => roman(Number(month.slice(0, 4)));
---

<BaseLayout
  title="Archive — sreeraj.dev"
  description="Catalogus editionum: every past monthly edition of sreeraj.dev, preserved as it was printed."
  section={{ label: 'Catalogus', href: '/archive/' }}
  runningTitle="Catalogus editionum"
>
  <div class="folio">
    <header class="page-head">
      <span class="liber sc">Bibliotheca</span>
      <h1 class="page-title">Catalogus editionum</h1>
      <p class="page-description">
        This book is reset in a new manner every month. The earlier editions
        are kept here as a bibliographer would describe them — each preserved
        exactly as it left the press.
      </p>
      <span class="fleuron" aria-hidden="true">❧</span>
    </header>

    <aside class="marg head-note" aria-label="About the catalogue">
      <Device class="device" letters={false} />
      <strong>{archives.length}</strong>
      editiones priores. The present edition, after Aldus (Venetiis, 1499), joins them when the next is printed.
    </aside>

    <ol class="catalogus git-log-timeline">
      {archives.map((e) => (
        <li class="gl-entry">
          <a href={`/archive/${e.month}/`} class="edition" style={`--swatch:${e.primaryColor}`}>
            <span class="gl-hash">{e.month}</span>
            <span class="gl-tag">{e.trend}.</span>
            {' '}[sreeraj.dev: the officina of Sreeraj, {yearOf(e.month)}].
            <span class="gl-msg">{e.description}</span>
            <span class="gl-date sc">
              Printed {fmt(e.deployedAt)} · ink <span class="swatch" aria-hidden="true"></span>{e.primaryColor} ·
              <span class="inspice">inspice editionem &rarr;</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
