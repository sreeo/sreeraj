---
import BaseLayout from '../../layouts/BaseLayout.astro';
import registryData from '../../../public/archive/registry.json';

const archives = registryData.archives || [];
const fmt = (iso: string) => iso.slice(0, 10);
---

<BaseLayout
  title="Archive — sreeraj.dev"
  description="Every past monthly redesign of sreeraj.dev, preserved as deployed."
  theme="tech"
>
  <header class="page-poster">
    <div class="wrap page-poster-grid">
      <div>
        <span class="stamp">Museum</span>
        <h1 class="page-title">Past editions</h1>
        <p class="page-description">
          This site is reprinted in a new idiom every month. Each earlier
          edition is preserved exactly as it was deployed.
        </p>
      </div>
      <div class="count-stamp" aria-hidden="true">
        <strong>{String(archives.length).padStart(2, '0')}</strong>
        <span>{archives.length === 1 ? 'edition' : 'editions'}</span>
      </div>
    </div>
  </header>

  <section class="wrap sec" aria-label="Past editions">
    <ol class="editions">
      {archives.map((edition) => (
        <li data-reveal>
          <a href={`/archive/${edition.month}/`} class="edition" style={`--swatch:${edition.primaryColor}`}>
            <span class="edition-swatch" aria-hidden="true"></span>
            <span class="edition-month">{edition.month}</span>
            <span class="edition-trend">{edition.trend}</span>
            <span class="edition-desc">{edition.description}</span>
            <span class="edition-date">Deployed {fmt(edition.deployedAt)} — view &rarr;</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="sec-sub" style="margin-top: var(--s-7);">
      The current Constructivist edition joins the museum when November's
      poster replaces it.
    </p>
  </section>
</BaseLayout>
