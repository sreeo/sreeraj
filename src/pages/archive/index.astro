---
import BaseLayout from '../../layouts/BaseLayout.astro';
import registryData from '../../../public/archive/registry.json';

const archives = registryData.archives || [];

const spans = ['c7', 'c5', 'c5', 'c7'];
const fmt = (iso: string) => iso.slice(0, 10);
---

<BaseLayout
  title="archive — sreeraj.dev"
  description="Every past monthly redesign of sreeraj.dev, preserved."
  theme="tech"
>
  <div class="band">
    <div class="cell label-cell cell--red c3">
      <span>museum /</span>
    </div>
    <div class="cell c7">
      <h1 class="page-title">past compositions</h1>
      <p class="section-sub">
        this site is repainted monthly — {archives.length}
        {archives.length === 1 ? 'edition is' : 'editions are'} preserved exactly as deployed
      </p>
    </div>
    <div class="plane plane--yellow c2" aria-hidden="true"></div>
  </div>

  <div class="band">
    {archives.map((edition, i) => (
      <a href={`/archive/${edition.month}/`} class:list={['edition-cell', spans[i % spans.length]]}>
        <span class="edition-month">
          <span class="edition-swatch" style={`background: ${edition.primaryColor};`} aria-hidden="true"></span>
          {edition.month}
        </span>
        <span class="edition-trend">{edition.trend}</span>
        <span class="edition-desc">{edition.description}</span>
        <span class="edition-date">deployed {fmt(edition.deployedAt)} &middot; view &rarr;</span>
      </a>
    ))}
    <div class="plane plane--blue c5" aria-hidden="true"></div>
    <div class="cell c7" style="display: flex; align-items: center;">
      <p style="margin: 0; color: var(--muted); font-size: var(--t-sm);">
        the current de stijl edition will join the museum when october's
        composition replaces it.
      </p>
    </div>
  </div>
</BaseLayout>
