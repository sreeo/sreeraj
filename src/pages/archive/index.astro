---
import BaseLayout from '../../layouts/BaseLayout.astro';
import registryData from '../../../public/archive/registry.json';

const archives = (registryData.archives || []).slice().sort((a, b) => (a.month < b.month ? 1 : -1));

const iso = (s: string) => (s ? s.slice(0, 10) : '—');
---

<BaseLayout title="Archive — sreeraj.dev" description="Every monthly redesign of sreeraj.dev, preserved as deployed.">
  <section class="wrap section-tight">
    <nav class="crumbs" aria-label="Breadcrumb" style="margin-bottom: var(--s-5);">
      <a href="/">~</a>
      <span aria-hidden="true">/</span>
      <span>archive</span>
    </nav>

    <div class="slab">
      <h1>INDEX OF /ARCHIVE</h1>
      <span class="slab-note">{archives.length} EDITIONS · ONE PER MONTH</span>
    </div>

    <p style="margin-top: var(--s-4); max-width: 62ch; font-size: var(--t-md); line-height: 1.65; color: var(--muted);">
      This site is torn down and redesigned every month in a different style.
      Old editions are not deleted — they are archived exactly as deployed,
      dead pixels and all. You are currently reading the Brutalist edition.
    </p>

    <div style="margin-top: var(--s-5); border-bottom: var(--rule-3);">
      {archives.map((a) => (
        <a href={`/archive/${a.month}/`} class="arch-row">
          <span class="arch-month">{a.month}</span>
          <span>
            <span class="arch-trend">{a.trend}</span>
            {a.description && <span class="arch-desc">{a.description}</span>}
          </span>
          <span class="arch-color">
            <span class="swatch" style={`background: ${a.primaryColor};`}></span>
            <span>{a.primaryColor}</span>
            <span aria-hidden="true">·</span>
            <span>{iso(a.deployedAt)}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
