---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const about = pages.find((p) => p.data.slug === 'about');
if (!about) throw new Error('about page missing from pages collection');
const { Content } = await render(about);
---

<BaseLayout
  title="About — sreeraj.dev"
  description="Who Sreeraj Rajan is and what he does."
  section={{ label: 'De auctore', href: '/about/' }}
  runningTitle="Vita auctoris"
>
  <div class="folio">
    <header class="page-head">
      <span class="liber sc">De auctore</span>
      <h1 class="page-title">The Author</h1>
      <p class="page-description">
        Backend engineer, keeper of infrastructure, walker of high passes —
        and, for this volume, its compositor and printer.
      </p>
      <span class="fleuron" aria-hidden="true">❧</span>
    </header>

    {about.data.featureImage ? (
      <figure class="marg portrait">
        <span class="frame"><img src={about.data.featureImage} alt="Sreeraj's dog, looking directly at the camera" loading="eager" width="400" height="500" /></span>
        <figcaption class="fig-caption"><b>Fig. i.</b> The guardian of the officina, who approves of nothing until it is fed.</figcaption>
      </figure>
    ) : <span class="marg"></span>}

    <div class="prose" data-initial>
      <Content />
    </div>

    <p class="catchword">Vale.</p>
  </div>
</BaseLayout>
