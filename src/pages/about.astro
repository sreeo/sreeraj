---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const about = pages.find((p) => p.data.slug === 'about');
if (!about) throw new Error('about page missing from pages collection');
const { Content } = await render(about);
---

<BaseLayout title="about — sreeraj.dev" description="Who Sreeraj Rajan is and what he does." theme="tech">
  <div class="band" style="grid-auto-rows: minmax(72px, auto);">
    <div class="cell label-cell cell--red c2">
      <span>person /</span>
    </div>
    <div class="cell c7" style="display: flex; flex-direction: column; justify-content: center;">
      <h1 class="page-title">about the composer</h1>
      <p class="section-sub">backend engineer &middot; trekker &middot; occasional open-source contributor</p>
    </div>
    {about.data.featureImage ? (
      <div class="page-portrait c3" style="grid-row: span 2;">
        <img src={about.data.featureImage} alt="Sreeraj's dog" />
      </div>
    ) : (
      <div class="plane plane--blue c3" aria-hidden="true"></div>
    )}
    <div class="plane plane--yellow c2" aria-hidden="true"></div>
    <div class="plane plane--white c7" aria-hidden="true"></div>
  </div>

  <div class="band prose-band">
    <div class="cell prose-cell c12">
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>
