---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const about = pages.find((p) => p.data.slug === 'about');
if (!about) throw new Error('about page missing from pages collection');
const { Content } = await render(about);
---

<BaseLayout title="About — sreeraj.dev" description="Who runs this site, and why.">
  <section class="wrap section-tight">
    <nav class="crumbs" aria-label="Breadcrumb" style="margin-bottom: var(--s-5);">
      <a href="/">~</a>
      <span aria-hidden="true">/</span>
      <span>about</span>
    </nav>

    <div class="slab">
      <h1>INDEX OF /ABOUT</h1>
      <span class="slab-note">1 PERSON · 1 DOG</span>
    </div>

    {about.data.featureImage && (
      <figure class="fig" style="margin-top: var(--s-6); max-width: 680px;">
        <img src={about.data.featureImage} alt="A dog, photographed by Sreeraj" />
        <figcaption>FIG. 01 — NOT THE AUTHOR. THE AUTHOR TOOK THE PHOTO.</figcaption>
      </figure>
    )}

    <div class="doc" style="margin-top: var(--s-6);">
      <Content />
    </div>
  </section>
</BaseLayout>
