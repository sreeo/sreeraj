---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const aboutPage = pages.find((p) => p.data.slug === 'about');
const { Content } = aboutPage ? await render(aboutPage) : { Content: null };
const image = aboutPage?.data.featureImage;
---

<BaseLayout title="About — sreeraj.dev" description="Engineer, trekker, occasional open-source contributor." theme="tech">
  <section class="container" style="padding-top: clamp(3rem, 7vw, 5rem); padding-bottom: clamp(4rem, 9vw, 7rem);">
    <div class="grid-12" style="row-gap: 3rem; column-gap: clamp(2rem, 5vw, 4rem);">
      <!-- Left: identity -->
      <aside style="grid-column: span 5;" class="max-lg:!col-span-12">
        <div style="position: sticky; top: 6rem;">
          <span class="kicker">Colophon</span>
          <h1 class="page-title" style="font-size: var(--fs-2xl); font-weight: 800; line-height: 1.05; letter-spacing: -0.04em; margin-top: 1.1rem;">
            About<br />the <span class="mark">author</span>
          </h1>
          {image && (
            <img src={image} alt="Sreeraj Rajan" class="brutal-frame" style="margin-top: 2rem; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; max-width: 22rem;" />
          )}
          <dl style="margin-top: 2rem; display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.25rem; font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: 0.04em; text-transform: uppercase;">
            <dt style="color: var(--color-tech-text-muted);">Role</dt><dd>Generalist Software Engineer</dd>
            <dt style="color: var(--color-tech-text-muted);">At</dt><dd>Medley Learning</dd>
            <dt style="color: var(--color-tech-text-muted);">Based</dt><dd>India</dd>
            <dt style="color: var(--color-tech-text-muted);">Off-hours</dt><dd>Himalayan trails</dd>
          </dl>
        </div>
      </aside>

      <!-- Right: prose -->
      <div style="grid-column: span 7 / -1;" class="max-lg:!col-span-12">
        <div class="rule" style="margin-bottom: 2.5rem;"></div>
        {Content ? (
          <div class="prose" style="max-width: 38rem;"><Content /></div>
        ) : (
          <p class="page-description">About page content not found.</p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
