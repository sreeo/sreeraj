---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const about = pages.find((p) => p.data.slug === 'about');
if (!about) throw new Error('about page missing from pages collection');
const { Content } = await render(about);
---

<BaseLayout title="About — sreeraj.dev" description="Who Sreeraj Rajan is and what he does." theme="tech">
  <header class="page-poster">
    <div class="wrap page-poster-grid">
      <div>
        <span class="stamp">Dossier</span>
        <h1 class="page-title">About the author</h1>
        <p class="page-description">
          Backend engineer, trekker, occasional open-source contributor.
          Currently building at Medley Learning.
        </p>
      </div>
      {about.data.featureImage && (
        <figure class="portrait" aria-label="Portrait">
          <div class="portrait-circle montage montage--mono" style={`--img:url('${about.data.featureImage}')`}>
            <img src={about.data.featureImage} alt="Sreeraj's dog, looking directly at the camera" loading="eager" />
          </div>
          <div class="portrait-wedge" aria-hidden="true"></div>
        </figure>
      )}
    </div>
  </header>

  <section class="wrap">
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>
