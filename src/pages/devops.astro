---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('devops'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="DevOps"
  path="devops"
  posts={posts}
  note="Pipelines, clusters, ingresses, and the occasional 3 a.m. incident. Notes from keeping things running."
/>
