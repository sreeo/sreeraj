---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('devops'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="DevOps"
  liber="Liber primus"
  rubric="DevOps"
  description="Kubernetes, pipelines, reverse proxies and the machinery that keeps production standing."
  theme="tech"
  posts={posts}
/>
