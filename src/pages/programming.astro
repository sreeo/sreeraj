---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('programming'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="Programming"
  kicker="Section 03"
  description="Workflows, tooling and code — how the work actually gets done."
  theme="tech"
  posts={posts}
/>
