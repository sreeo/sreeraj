---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('postgres'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="Postgres"
  liber="Liber secundus"
  rubric="Postgres"
  description="Indexes, identifiers and benchmarks, measured from inside the database."
  theme="tech"
  posts={posts}
/>
