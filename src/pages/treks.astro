---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('treks') || p.data.tags.includes('trek'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="Treks"
  path="treks"
  posts={posts}
  note="Himalayan trail logs — altitudes, distances, and what actually happened. Links are green up here."
  theme="trek"
/>
