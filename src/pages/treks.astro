---
import { getCollection } from 'astro:content';
import TagLayout from '../layouts/TagLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.tags.includes('treks') || p.data.tags.includes('trek'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<TagLayout
  title="Treks"
  liber="Liber quartus"
  rubric="Itinera"
  description="Himalayan passes and summits — itineraries, altitudes, and the days the weather won."
  theme="trek"
  posts={posts}
/>
