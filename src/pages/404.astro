---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — sreeraj.dev" description="This page was never printed." theme="tech">
  <section class="wrap lost">
    <span class="stamp">Never printed</span>
    <div>
      <h1 class="lost-code">404</h1>
    </div>
    <p class="lost-text">
      The page you were sent to was pulled from the press, moved to another
      run, or never set in type at all.
    </p>
    <a href="/" class="cta">Back to the poster</a>
  </section>
</BaseLayout>
