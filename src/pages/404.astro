---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — sreeraj.dev" description="File not found.">
  <section class="wrap section-tight">
    <div class="err-block">
      <p class="err-code" aria-hidden="true">404</p>
      <h1 class="err-msg">ERR — FILE NOT FOUND</h1>
      <p class="mono" style="margin-top: var(--s-4); font-size: var(--t-sm); max-width: 60ch; line-height: 1.7;">
        The requested path does not exist on this server. It may have been
        renamed, removed, or never written. That is all the information
        there is.
      </p>
      <p class="mono" style="margin-top: var(--s-5); font-size: var(--t-sm);">
        <a href="/">RETURN TO INDEX OF /</a>
      </p>
    </div>
  </section>
</BaseLayout>
