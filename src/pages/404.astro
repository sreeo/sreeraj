---
import BaseLayout from '../layouts/BaseLayout.astro';

const routes = [
  { label: 'The Index', href: '/' },
  { label: 'DevOps', href: '/devops/' },
  { label: 'Treks', href: '/treks/' },
  { label: 'Programming', href: '/programming/' },
  { label: 'Postgres', href: '/postgres/' },
];
---

<BaseLayout title="404 — Off the map" theme="tech">
  <section class="container" style="padding-top: clamp(3rem, 10vw, 7rem); padding-bottom: clamp(4rem, 12vw, 8rem);">
    <div class="grid-12" style="row-gap: 2.5rem; align-items: center;">
      <div style="grid-column: span 7;" class="max-lg:!col-span-12">
        <span class="eyebrow">Errata · 404</span>
        <h1 style="font-family: var(--font-display); font-size: var(--fs-display); font-weight: 900; line-height: 0.9; letter-spacing: -0.04em; margin-top: 1.25rem; font-variation-settings: 'opsz' 144, 'wght' 900;">
          Off the<br /><span style="font-style: italic; color: var(--color-accent);">map.</span>
        </h1>
        <p class="deck" style="font-size: var(--fs-md); max-width: 30rem; margin-top: 1.6rem; color: var(--color-tech-text-muted);">
          This page has wandered above the treeline. Pick a marked trail below and head back to the issue.
        </p>
      </div>

      <nav style="grid-column: span 4 / -1;" class="max-lg:!col-span-12">
        <div class="rule-double" style="margin-bottom: 0.5rem;"></div>
        {routes.map((r) => (
          <a href={r.href} class="toc-row group" style="grid-template-columns: 1fr auto;">
            <span class="toc-title" style="display: block;">{r.label}</span>
            <span class="transition-transform group-hover:translate-x-1" style="color: var(--color-accent); align-self: center;">→</span>
          </a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
