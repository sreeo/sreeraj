---
import BaseLayout from '../layouts/BaseLayout.astro';

const routes = [
  { label: 'Index', href: '/' },
  { label: 'DevOps', href: '/devops/' },
  { label: 'Treks', href: '/treks/' },
  { label: 'Programming', href: '/programming/' },
  { label: 'Postgres', href: '/postgres/' },
];
---

<BaseLayout title="404 — Off the map" theme="tech">
  <section class="container" style="padding-top: clamp(4rem, 12vw, 9rem); padding-bottom: clamp(5rem, 12vw, 9rem);">
    <div class="grid-12" style="row-gap: 2.5rem; align-items: center;">
      <div style="grid-column: span 7;" class="max-lg:!col-span-12">
        <span class="kicker">Error 404</span>
        <h1 style="font-size: var(--fs-hero); font-weight: 800; line-height: 0.9; letter-spacing: -0.04em; margin-top: 1.25rem;">
          Off the<br /><span style="color: var(--color-accent);">map.</span>
        </h1>
        <p style="font-size: var(--fs-md); line-height: 1.55; max-width: 30rem; margin-top: 1.75rem; color: var(--color-tech-text-muted);">
          The page you're looking for has wandered above the treeline. Pick a marked trail below.
        </p>
      </div>

      <nav style="grid-column: span 4 / -1;" class="max-lg:!col-span-12">
        <div class="rule"></div>
        {routes.map((r) => (
          <a href={r.href} class="index-row group flex items-baseline justify-between" style="gap: 1rem; padding: 1.1rem 1.15rem;">
            <span class="transition-colors group-hover:text-[var(--color-accent)]" style="font-size: var(--fs-md); font-weight: 600;">{r.label}</span>
            <span class="index-arrow transition-transform group-hover:translate-x-1">→</span>
          </a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
