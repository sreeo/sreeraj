---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const contact = pages.find((p) => p.data.slug === 'contact');
if (!contact) throw new Error('contact page missing from pages collection');
const { Content } = await render(contact);
---

<BaseLayout title="contact — sreeraj.dev" description="How to reach Sreeraj Rajan." theme="tech">
  <div class="band" style="grid-auto-rows: minmax(72px, auto);">
    <div class="cell label-cell cell--blue c2">
      <span>letters /</span>
    </div>
    <div class="cell c7" style="display: flex; flex-direction: column; justify-content: center;">
      <h1 class="page-title">get in touch</h1>
      <p class="section-sub">letters, corrections &amp; trek plans all welcome</p>
    </div>
    {contact.data.featureImage ? (
      <div class="page-portrait c3" style="grid-row: span 2;">
        <img src={contact.data.featureImage} alt="A view from one of Sreeraj's treks" />
      </div>
    ) : (
      <div class="plane plane--yellow c3" aria-hidden="true"></div>
    )}
    <div class="plane plane--yellow c2" aria-hidden="true"></div>
    <div class="plane plane--white c7" aria-hidden="true"></div>
  </div>

  <div class="band prose-band">
    <div class="cell prose-cell c12">
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>
