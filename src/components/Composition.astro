---
// A generative De Stijl composition. Rendered server-side from a
// date-derived seed so it always paints; a click re-composes it
// client-side with a fresh seed.

interface Rect {
  x: number;
  y: number;
  w: number;
  h: number;
  fill: string;
}

const W = 300;
const H = 400;

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function compose(rand: () => number): Rect[] {
  let rects = [{ x: 0, y: 0, w: W, h: H }];
  for (let round = 0; round < 3; round++) {
    rects = rects.flatMap((r) => {
      if (rand() > 0.74 || (r.w < 80 && r.h < 80)) return [r];
      const vertical = r.w > r.h ? rand() < 0.75 : rand() < 0.25;
      const t = [0.382, 0.5, 0.618][Math.floor(rand() * 3)];
      if (vertical) {
        const w = r.w * t;
        return [{ ...r, w }, { ...r, x: r.x + w, w: r.w - w }];
      }
      const h = r.h * t;
      return [{ ...r, h }, { ...r, y: r.y + h, h: r.h - h }];
    });
  }
  const paints = ['#d21f0f', '#1e50a0', '#f6c90e', '#131313'];
  return rects.map((r) => ({
    ...r,
    fill: rand() < 0.6 ? '#fdfcf9' : paints[Math.floor(rand() * paints.length)],
  }));
}

const today = new Date();
const seed =
  today.getUTCFullYear() * 10000 + (today.getUTCMonth() + 1) * 100 + today.getUTCDate();
const rects = compose(mulberry32(seed));
---

<button class="hero-comp" id="hero-comp" aria-label="Generate a new composition" title="click to re-compose">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g id="comp-g">
      {rects.map((r, i) => (
        <rect
          class="comp-rect"
          x={r.x}
          y={r.y}
          width={r.w}
          height={r.h}
          fill={r.fill}
          stroke="#131313"
          stroke-width="7"
          style={`animation-delay: ${i * 45}ms`}
        />
      ))}
    </g>
  </svg>
  <span class="comp-hint">re-compose</span>
</button>

<script>
  // Click to re-compose: same algorithm, fresh seed. ~40 lines, no deps.
  const W = 300, H = 400;
  const mulberry32 = (seed: number) => () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const compose = (rand: () => number) => {
    let rects = [{ x: 0, y: 0, w: W, h: H }];
    for (let round = 0; round < 3; round++) {
      rects = rects.flatMap((r) => {
        if (rand() > 0.74 || (r.w < 80 && r.h < 80)) return [r];
        const vertical = r.w > r.h ? rand() < 0.75 : rand() < 0.25;
        const t = [0.382, 0.5, 0.618][Math.floor(rand() * 3)];
        if (vertical) {
          const w = r.w * t;
          return [{ ...r, w }, { ...r, x: r.x + w, w: r.w - w }];
        }
        const h = r.h * t;
        return [{ ...r, h }, { ...r, y: r.y + h, h: r.h - h }];
      });
    }
    const paints = ['#d21f0f', '#1e50a0', '#f6c90e', '#131313'];
    return rects.map((r) => ({
      ...r,
      fill: rand() < 0.6 ? '#fdfcf9' : paints[Math.floor(rand() * paints.length)],
    }));
  };
  const btn = document.getElementById('hero-comp');
  const g = document.getElementById('comp-g');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  btn?.addEventListener('click', () => {
    if (!g) return;
    const ns = 'http://www.w3.org/2000/svg';
    g.replaceChildren(
      ...compose(mulberry32((Math.random() * 2 ** 31) | 0)).map((r, i) => {
        const el = document.createElementNS(ns, 'rect');
        el.setAttribute('class', 'comp-rect');
        el.setAttribute('x', String(r.x));
        el.setAttribute('y', String(r.y));
        el.setAttribute('width', String(r.w));
        el.setAttribute('height', String(r.h));
        el.setAttribute('fill', r.fill);
        el.setAttribute('stroke', '#131313');
        el.setAttribute('stroke-width', '7');
        if (!reduced) el.style.animationDelay = `${i * 45}ms`;
        return el;
      })
    );
  });
</script>
