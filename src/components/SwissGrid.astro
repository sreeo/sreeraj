---
// Generative signature: a deterministic Müller-Brockmann-style modular
// composition — grid, red squares, concentric arcs, one slow sweeping ray.
// Pure vanilla canvas. Feature-detected + null-guarded + reduced-motion aware.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<div class:list={['swiss-grid-art', className]} aria-hidden="true">
  <canvas id="swiss-grid-canvas"></canvas>
</div>

<style>
  .swiss-grid-art { position: relative; width: 100%; aspect-ratio: 1 / 1; }
  .swiss-grid-art canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  (function () {
    try {
      const canvas = document.getElementById('swiss-grid-canvas') as HTMLCanvasElement | null;
      if (!canvas || typeof canvas.getContext !== 'function') return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const RED = '#e1261c';
      const INK = '#16151a';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let s = 1337;
      const rnd = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
      const N = 7;
      const reds = new Set([10, 17, 24, 31, 38]); // deterministic accent cells

      function paint(t: number) {
        if (!ctx || !canvas) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const size = canvas.clientWidth || 320;
        canvas.width = size * dpr; canvas.height = size * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, size, size);
        const cell = size / N;

        // faint module grid
        ctx.strokeStyle = 'rgba(22,21,26,0.12)'; ctx.lineWidth = 1;
        for (let i = 0; i <= N; i++) {
          ctx.beginPath(); ctx.moveTo(i * cell, 0); ctx.lineTo(i * cell, size); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i * cell); ctx.lineTo(size, i * cell); ctx.stroke();
        }
        // red square modules
        ctx.fillStyle = RED;
        reds.forEach((idx) => {
          const x = (idx % N) * cell, y = Math.floor(idx / N) * cell;
          ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2);
        });
        // concentric quarter arcs anchored bottom-left
        ctx.strokeStyle = INK; ctx.lineWidth = 1.4;
        for (let r = 1; r <= 5; r++) {
          ctx.beginPath(); ctx.arc(0, size, r * cell, -Math.PI / 2, 0); ctx.stroke();
        }
        // slow sweeping ray from the lower-left origin
        const ang = -Math.PI / 2 + (reduce ? 0.6 : (t / 4200) % (Math.PI / 2));
        ctx.strokeStyle = RED; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(0, size);
        ctx.lineTo(Math.cos(ang) * size * 1.1, size + Math.sin(ang) * size * 1.1);
        ctx.stroke();
        rnd();
      }

      const loop = (t: number) => { paint(t); if (!reduce) requestAnimationFrame(loop); };
      const start = () => { paint(0); if (!reduce) requestAnimationFrame(loop); };
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start); else setTimeout(start, 0);
      window.addEventListener('resize', () => paint(reduce ? 0 : performance.now()));
    } catch (_) { /* never throw — generative art is decorative */ }
  })();
</script>
