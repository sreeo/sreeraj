---
// The running head: section on the left, the printer's mark in the middle,
// the work's title and its signature mark (a.i, a.ii …) on the right.
import Device from './Device.astro';
import Signatures from './Signatures.astro';

interface Props {
  section?: { label: string; href: string };
  runningTitle?: string;
}

const { section, runningTitle = 'sreeraj.dev' } = Astro.props;
const path = Astro.url.pathname;

const LINKS = [
  { href: '/', label: 'Home', latin: 'Tabula' },
  { href: '/about/', label: 'About', latin: 'De auctore' },
  { href: '/devops/', label: 'DevOps', latin: 'Liber primus' },
  { href: '/postgres/', label: 'Postgres', latin: 'Liber secundus' },
  { href: '/programming/', label: 'Programming', latin: 'Liber tertius' },
  { href: '/treks/', label: 'Treks', latin: 'Itinera' },
  { href: '/archive/', label: 'Archive', latin: 'Catalogus editionum' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav-bar">
  <div class="running-head">
    <span class="rh-section sc">
      {section ? <a href={section.href}>{section.label}</a> : <span>Tabula</span>}
    </span>
    <a href="/" class="nav-brand" aria-label="sreeraj.dev — home">
      <Device letters={false} />
      <span>Sreeraj</span>
    </a>
    <span class="rh-folio">
      <span class="rh-title">{runningTitle}</span>
      <span class="sig" id="sig" title="Signature mark — your place in the gathering">a.i</span>
    </span>
  </div>
</header>
<nav aria-label="Main" data-qa="site-nav">
  <ul class="nav-links">
    {LINKS.map((l) => (
      <li>
        <a href={l.href} class="nav-link" title={l.latin} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      </li>
    ))}
  </ul>
</nav>
<Signatures />
