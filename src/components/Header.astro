---
const navItems = [
  { label: 'home', href: '/' },
  { label: 'about', href: '/about/' },
  { label: 'devops', href: '/devops/' },
  { label: 'treks', href: '/treks/' },
  { label: 'programming', href: '/programming/' },
  { label: 'postgres', href: '/postgres/' },
  { label: 'archive', href: '/archive/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav-bar">
  <a href="/" class="nav-brand">sreeraj<span class="dot">.</span>dev</a>
  <nav style="display: contents;" aria-label="Site">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="nav-link"
        aria-current={isActive(item.href) ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
  <span class="nav-void" aria-hidden="true"></span>
  <a href="/rss.xml" class="nav-rss">rss</a>
</header>
