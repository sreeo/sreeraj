---
interface Props {
  theme?: 'tech' | 'trek';
}

const { theme = 'tech' } = Astro.props;

const navItems = [
  { label: 'Index', href: '/' },
  { label: 'DevOps', href: '/devops/' },
  { label: 'Treks', href: '/treks/' },
  { label: 'Programming', href: '/programming/' },
  { label: 'Postgres', href: '/postgres/' },
  { label: 'About', href: '/about/' },
  { label: 'Archive', href: '/archive/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const now = new Date();
const issueNo = String(Math.max(1, (now.getFullYear() - 2026) * 12 + now.getMonth() + 1)).padStart(2, '0');
const issueDate = now
  .toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  .toUpperCase();
---

<header class:list={['nav-bar', theme === 'trek' && 'trek']}>
  <!-- Folio line -->
  <div class="container">
    <div class="folio-bar">
      <span class="folio">Est. MMXXVI</span>
      <span class="folio center max-md:hidden">A Field Journal of Systems &amp; Summits</span>
      <span class="folio">{issueDate} · N&ordm;&nbsp;{issueNo}</span>
    </div>
  </div>

  <!-- Nameplate -->
  <div class="container" style="text-align: center; padding-block: clamp(1.1rem, 3vw, 1.9rem);">
    <a href="/" class="nav-brand" style="font-size: clamp(2.4rem, 7vw, 4.25rem);">
      Sreeraj<span class="dot">.</span>dev
    </a>
  </div>

  <!-- Department navigation -->
  <div class="container">
    <nav class="dept-nav" aria-label="Sections">
      {navItems.map((item) => (
        <a href={item.href} class:list={['nav-link', isActive(item.href) && 'active']}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
