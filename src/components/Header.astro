---
interface Props {
  theme?: 'tech' | 'trek';
}

const { theme = 'tech' } = Astro.props;

const navItems = [
  { label: 'Index', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'DevOps', href: '/devops/' },
  { label: 'Treks', href: '/treks/' },
  { label: 'Programming', href: '/programming/' },
  { label: 'Postgres', href: '/postgres/' },
  { label: 'Archive', href: '/archive/' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="site-ethos-bar">
  <div class="container">
    <p class="site-ethos">This site is rebuilt in a new visual idiom every month. Each previous design is preserved, frozen in time.</p>
  </div>
</div>

<header class="nav-bar sticky top-0 z-50">
  <div class="container flex items-center justify-between" style="height: 4.25rem;">
    <a href="/" class="nav-brand" style="font-size: 1.25rem;">
      sreeraj<span class="dot">.</span>dev
    </a>

    <button id="menu-toggle" class="md:hidden nav-link" aria-label="Toggle menu" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>

    <nav class="hidden md:flex items-center" style="gap: 1.6rem;">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', isActive(item.href) && 'active']}
          style="font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; padding-bottom: 4px;"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden container" style="padding-bottom: 1.25rem;">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={['nav-link block', isActive(item.href) && 'active']}
        style="font-family: var(--font-mono); font-size: var(--fs-sm); letter-spacing: 0.06em; text-transform: uppercase; padding: 0.5rem 0; width: fit-content;"
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(hidden === false));
  });
</script>
