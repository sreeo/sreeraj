---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  featured?: boolean;
  num: string;
}

const {
  title, slug, description = '', pubDate,
  tags = [], readingTime = 1, featured = false, num,
} = Astro.props;

const shownTags = tags.slice(0, 2);
const moreTags = tags.length - shownTags.length;
---

<a href={`/${slug}/`} class="idx-row">
  <span class="idx-num" aria-hidden="true">{num}</span>
  <span class="idx-date"><FormattedDate date={pubDate} /></span>
  <span>
    <span class="idx-title">
      {featured && <span class="idx-star" aria-label="featured">★ </span>}{title}
    </span>
    {description && <span class="idx-desc">{description}</span>}
    <span class="idx-date-inline"><FormattedDate date={pubDate} /></span>
  </span>
  <span class="idx-tags">{shownTags.map((t) => `[${t}]`).join(' ')}{moreTags > 0 ? ` +${moreTags}` : ''}</span>
  <span class="idx-min">{readingTime}′</span>
</a>
