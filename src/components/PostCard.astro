---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  slug: string;
  description: string;
  pubDate: Date;
  featureImage?: string;
  tags?: string[];
  readingTime?: number;
  variant?: 'tech' | 'trek';
  index?: number;
}

const { title, slug, description, pubDate, featureImage, tags = [], readingTime, variant = 'tech', index } = Astro.props;
const primaryTag = tags[0] ?? 'note';
const num = index != null ? String(index).padStart(2, '0') : null;
---

<article class:list={['post-card group flex flex-col h-full', variant === 'trek' && 'trek-card']}>
  <a href={`/${slug}/`} class="flex flex-col h-full" style="padding: 1.25rem;">
    <div class="flex items-baseline justify-between" style="margin-bottom: 1rem;">
      <span class="kicker" style="font-size: var(--fs-2xs);">{primaryTag}</span>
      {num && <span class="post-card-index" style="font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 700; padding: 0.1rem 0.4rem; line-height: 1.3;">{num}</span>}
    </div>

    {featureImage && (
      <div class="overflow-hidden" style="margin-bottom: 1.1rem; aspect-ratio: 16 / 10;">
        <img
          src={featureImage}
          alt={title}
          loading="lazy"
          class="post-card-image w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      </div>
    )}

    <h3 class="post-card-title transition-colors" style="font-size: var(--fs-lg); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;">
      {title}
    </h3>

    {description && (
      <p class="post-card-description" style="font-size: var(--fs-sm); line-height: 1.6; margin-top: 0.6rem;">
        {description}
      </p>
    )}

    <div class="post-card-divider" style="height: 1px; margin-top: 1.1rem; margin-bottom: 0.85rem;"></div>

    <div class="post-card-meta flex items-center gap-3 mt-auto" style="font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: 0.04em; text-transform: uppercase;">
      <FormattedDate date={pubDate} mono />
      {readingTime && <span>· {readingTime} min</span>}
    </div>
  </a>
</article>
