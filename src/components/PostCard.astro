---
// A post in two settings: a line of the Tabula (small caps, dotted leader to
// its date) or a register entry with its woodcut in the outer margin.
import FormattedDate from './FormattedDate.astro';
import { romanLower } from '../utils/roman';
import { sectionFor } from '../utils/sections';

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  featureImage?: string;
  num: number;
  variant?: 'tabula' | 'register';
}

const { title, slug, description, pubDate, tags = [], readingTime = 1, featureImage, num, variant = 'tabula' } = Astro.props;
const section = sectionFor(tags);
---

{variant === 'tabula' ? (
  <a href={`/${slug}/`} class="post-card tabula-line" data-qa="post-card">
    <span class="tl-num" aria-hidden="true">{romanLower(num)}</span>
    <span class="gl-msg">{title}</span>
    <span class="tl-leader" aria-hidden="true"></span>
    <span class="gl-hash"><FormattedDate date={pubDate} /></span>
  </a>
) : (
  <article class="post-card post-card--register" data-qa="post-card">
    <div class="pc-body">
      <span class="pc-num" aria-hidden="true">Cap. {romanLower(num)}</span>
      <h2 class="post-card-title"><a href={`/${slug}/`}>{title}</a></h2>
      {description && <p class="post-card-desc">{description}</p>}
      <div class="post-card-meta sc">
        <FormattedDate date={pubDate} format="long" />
        <span class="sep" aria-hidden="true">·</span>
        <span>Lectio {readingTime} min</span>
        {section && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span>{section.rubric}</span>
          </>
        )}
      </div>
    </div>
    {featureImage && (
      <figure class="pc-figure frame" aria-hidden="true">
        <img src={featureImage} alt="" width="400" height="300" />
      </figure>
    )}
  </article>
)}
