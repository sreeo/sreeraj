---
// A film poster: red-duotone montage above, title plate below.
import FormattedDate from './FormattedDate.astro';
import { catFor, isTrek } from '../utils/sections';

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  featureImage?: string;
  num?: string;
  lead?: boolean;
}

const {
  title,
  slug,
  description = '',
  pubDate,
  tags = [],
  readingTime = 1,
  featureImage = '',
  num,
  lead = false,
} = Astro.props;

const cat = catFor(tags);
const trek = isTrek(tags);
---

<a
  href={`/${slug}/`}
  class:list={['post-card', lead && 'post-card--lead', trek && 'trek-card']}
  data-cat={cat.toLowerCase()}
  data-qa="post-card"
>
  <div class="post-card-visual montage" style={featureImage ? `--img:url('${featureImage}')` : undefined}>
    {featureImage ? (
      <img class="post-card-image" src={featureImage} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="post-card-blank" aria-hidden="true"></div>
    )}
    {num && <span class="post-card-no">N&ordm; {num}</span>}
  </div>
  <div class="post-card-body">
    <span class="post-card-cat">{cat}</span>
    <h3 class="post-card-title">{title}</h3>
    {description && <p class="post-card-description">{description}</p>}
    <div class="post-card-meta">
      <FormattedDate date={pubDate} />
      <span aria-hidden="true">/</span>
      <span>{readingTime} min</span>
    </div>
  </div>
</a>
