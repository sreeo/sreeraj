---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  num?: string;
  span?: string;
  lead?: boolean;
}

const {
  title,
  slug,
  description = '',
  pubDate,
  tags = [],
  readingTime = 1,
  num,
  span = 'c4',
  lead = false,
} = Astro.props;

const PAINTS: Array<{ cat: string; paint: string; match: string[] }> = [
  { cat: 'devops', paint: 'red', match: ['devops'] },
  { cat: 'postgres', paint: 'blue', match: ['postgres'] },
  { cat: 'programming', paint: 'yellow', match: ['programming'] },
  { cat: 'treks', paint: 'ink', match: ['treks', 'trek'] },
];

const found = PAINTS.find((p) => p.match.some((m) => tags.includes(m)));
const cat = found?.cat ?? tags[0] ?? 'notes';
const paint = found?.paint ?? 'ink';
---

<a href={`/${slug}/`} class:list={['post-card', span, lead && 'post-card--lead']} data-paint={paint}>
  <div class="post-card-head">
    <span class="post-card-cat">
      <span class="post-card-mark" aria-hidden="true"></span>
      {cat}
    </span>
    {num && <span class="post-card-no">no. {num}</span>}
  </div>
  <h3 class="post-card-title">{title}</h3>
  {description && <p class="post-card-description">{description}</p>}
  <div class="post-card-meta">
    <FormattedDate date={pubDate} />
    <span aria-hidden="true">/</span>
    <span>{readingTime} min</span>
  </div>
</a>
