---
// Generative signature: a deterministic neubrutalist composition — bordered
// blocks (squares, circles, quarter-arcs) each with a hard offset shadow,
// arranged on a loose grid and gently drifting. Pure vanilla canvas.
// Feature-detected + null-guarded + reduced-motion aware. Never throws.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<div class:list={['brutal-art', className]} aria-hidden="true">
  <canvas id="brutal-art-canvas"></canvas>
</div>

<style>
  .brutal-art { position: relative; width: 100%; aspect-ratio: 1 / 1; }
  .brutal-art canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  (function () {
    try {
      const canvas = document.getElementById('brutal-art-canvas') as HTMLCanvasElement | null;
      if (!canvas || typeof canvas.getContext !== 'function') return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const INK = '#19150d', VIOLET = '#7c3aed', YELLOW = '#ffd23f', PAPER = '#fffdf6';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Deterministic block set: [col, row, w, h, kind, fill, phase]
      // kind: 0=square 1=circle 2=quarter-arc
      const blocks: [number, number, number, number, number, string, number][] = [
        [0, 0, 2, 2, 0, VIOLET, 0.0], [3, 0, 2, 1, 1, YELLOW, 1.1],
        [4, 1, 1, 2, 0, PAPER, 2.0], [0, 3, 1, 1, 1, VIOLET, 0.6],
        [1, 3, 2, 2, 2, YELLOW, 1.7], [3, 3, 2, 2, 0, INK, 2.6],
        [0, 2, 1, 1, 0, YELLOW, 0.3],
      ];

      function paint(t: number) {
        if (!ctx || !canvas) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const size = canvas.clientWidth || 320;
        canvas.width = size * dpr; canvas.height = size * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, size, size);
        const u = size / 5;               // 5×5 module grid
        const pad = u * 0.16, sh = u * 0.24;

        for (const [c, r, w, h, kind, fill, ph] of blocks) {
          const dy = reduce ? 0 : Math.sin(t / 1400 + ph) * u * 0.05;
          const x = c * u + pad, y = r * u + pad + dy;
          const bw = w * u - pad * 2, bh = h * u - pad * 2;
          // hard offset shadow
          ctx.fillStyle = INK;
          drawShape(kind, x + sh, y + sh, bw, bh);
          // body
          ctx.fillStyle = fill; drawShape(kind, x, y, bw, bh);
          // border
          ctx.strokeStyle = INK; ctx.lineWidth = 3; strokeShape(kind, x, y, bw, bh);
        }
      }

      function drawShape(kind: number, x: number, y: number, w: number, h: number) {
        if (!ctx) return;
        ctx.beginPath();
        if (kind === 1) { const rad = Math.min(w, h) / 2; ctx.arc(x + w / 2, y + h / 2, rad, 0, Math.PI * 2); }
        else if (kind === 2) { ctx.moveTo(x, y + h); ctx.lineTo(x, y); ctx.arc(x, y + h, Math.min(w, h), -Math.PI / 2, 0); ctx.closePath(); }
        else ctx.rect(x, y, w, h);
        ctx.fill();
      }
      function strokeShape(kind: number, x: number, y: number, w: number, h: number) {
        if (!ctx) return;
        ctx.beginPath();
        if (kind === 1) { const rad = Math.min(w, h) / 2; ctx.arc(x + w / 2, y + h / 2, rad, 0, Math.PI * 2); }
        else if (kind === 2) { ctx.moveTo(x, y + h); ctx.lineTo(x, y); ctx.arc(x, y + h, Math.min(w, h), -Math.PI / 2, 0); ctx.closePath(); }
        else ctx.rect(x, y, w, h);
        ctx.stroke();
      }

      const loop = (t: number) => { paint(t); if (!reduce) requestAnimationFrame(loop); };
      const start = () => { paint(0); if (!reduce) requestAnimationFrame(loop); };
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start); else setTimeout(start, 0);
      window.addEventListener('resize', () => paint(reduce ? 0 : performance.now()));
    } catch (_) { /* never throw — generative art is decorative */ }
  })();
</script>
