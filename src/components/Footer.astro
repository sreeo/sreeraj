---
interface Props {
  theme?: 'tech' | 'trek';
}
const { theme = 'tech' } = Astro.props;

const year = new Date().getFullYear();

const sections = [
  { label: 'Index', href: '/' },
  { label: 'DevOps', href: '/devops/' },
  { label: 'Treks', href: '/treks/' },
  { label: 'Programming', href: '/programming/' },
  { label: 'Postgres', href: '/postgres/' },
];
const desk = [
  { label: 'About the author', href: '/about/' },
  { label: 'Correspondence', href: '/contact/' },
  { label: 'The Archive', href: '/archive/' },
  { label: 'All topics', href: '/tags/' },
  { label: 'RSS feed', href: '/rss.xml' },
];
---

<footer class:list={['site-footer', theme === 'trek' && 'trek']} style="margin-top: clamp(4rem, 10vw, 8rem);">
  <div class="container" style="padding-block: clamp(3rem, 6vw, 4.5rem);">
    <div class="grid-12" style="row-gap: 2.75rem;">
      <!-- Imprint -->
      <div style="grid-column: span 5;" class="max-md:!col-span-12">
        <div class="nav-brand" style="font-size: 2rem; line-height: 0.9;">
          Sreeraj<span class="dot">.</span>dev
        </div>
        <p style="font-family: var(--font-display); font-style: italic; font-size: var(--fs-md); line-height: 1.4; max-width: 24rem; margin-top: 1rem;">
          A field journal of distributed systems, databases, and high-altitude trails — reset in a new idiom every month.
        </p>
      </div>

      <!-- Sections -->
      <nav style="grid-column: span 3;" class="max-md:!col-span-6 flex flex-col">
        <span class="folio" style="margin-bottom: 1rem;">Sections</span>
        {sections.map((l) => (
          <a href={l.href} style="font-family: var(--font-display); font-size: var(--fs-md); font-weight: 500; padding: 0.28rem 0; width: fit-content; transition: color 0.2s;">{l.label}</a>
        ))}
      </nav>

      <!-- Desk -->
      <nav style="grid-column: span 4;" class="max-md:!col-span-6 flex flex-col">
        <span class="folio" style="margin-bottom: 1rem;">The Desk</span>
        {desk.map((l) => (
          <a href={l.href} style="font-size: var(--fs-sm); padding: 0.28rem 0; width: fit-content; transition: color 0.2s;">{l.label}</a>
        ))}
        <a href="https://twitter.com/bot_sree" style="font-size: var(--fs-sm); padding: 0.28rem 0; width: fit-content; transition: color 0.2s;">Twitter &#8599;</a>
      </nav>
    </div>

    <div class="rule-double" style="margin-top: 3rem;"></div>
    <div class="flex items-center justify-between max-sm:flex-col max-sm:items-start" style="gap: 0.75rem; margin-top: 1.1rem;">
      <span class="folio">&copy; {year} Sreeraj Rajan</span>
      <span class="folio">Set in Fraunces &amp; Lora · Composed with Astro</span>
    </div>
  </div>
</footer>
