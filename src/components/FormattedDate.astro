---
// Dates in three settings: the Arabic short form for tables, the long form
// for marginalia, and the Roman form of a colophon.
import { roman, romanLower, latinMonth } from '../utils/roman';

interface Props {
  date: Date;
  format?: 'short' | 'long' | 'roman';
}

const { date, format = 'short' } = Astro.props;
const spoken = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const short = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const text =
  format === 'roman'
    ? `${romanLower(date.getUTCDate())} ${latinMonth(date)} ${roman(date.getUTCFullYear())}`
    : format === 'long'
      ? spoken
      : short;
---

<time datetime={date.toISOString()} title={spoken}>{text}</time>
