---
// Generative signature: a procedural topographic contour engraving — nested
// ridge lines drawn from a layered sine height-field. Reads as both an
// intaglio/print ornament and a mountain contour map (systems & summits).
// Pure vanilla canvas. Feature-detected, null-guarded, reduced-motion aware.
interface Props {
  class?: string;
  ink?: string;    // base line colour (rgba)
  accent?: string; // single highlighted ridge
}
const {
  class: className = '',
  ink = 'rgba(33, 27, 22, 0.16)',
  accent = 'rgba(154, 42, 36, 0.55)',
} = Astro.props;
---

<div class:list={['contour-field', className]} aria-hidden="true" data-ink={ink} data-accent={accent}>
  <canvas></canvas>
</div>

<style>
  .contour-field { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .contour-field canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  (function () {
    try {
      const roots = document.querySelectorAll('.contour-field');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      roots.forEach((root) => {
        const canvas = root.querySelector('canvas') as HTMLCanvasElement | null;
        if (!canvas || typeof canvas.getContext !== 'function') return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const el = root as HTMLElement;
        const ink = el.dataset.ink || 'rgba(33,27,22,0.16)';
        const accent = el.dataset.accent || 'rgba(154,42,36,0.55)';
        const LAYERS = 18;

        function paint(phase: number) {
          if (!ctx || !canvas) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const w = el.clientWidth || 600;
          const h = el.clientHeight || 400;
          canvas.width = w * dpr; canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, w, h);
          ctx.lineWidth = 1;
          const gap = (h + 120) / LAYERS;
          const accentLine = 6;
          for (let i = 0; i < LAYERS; i++) {
            const baseY = -60 + i * gap;
            const a = gap * 0.5;
            ctx.beginPath();
            for (let x = 0; x <= w; x += 6) {
              const n =
                Math.sin(x * 0.0075 + i * 0.55 + phase) * a +
                Math.sin(x * 0.021 - i * 0.8) * (a * 0.4) +
                Math.sin(x * 0.004 + phase * 0.6) * (a * 0.6);
              const y = baseY + n;
              if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = i === accentLine ? accent : ink;
            ctx.stroke();
          }
        }

        let raf = 0;
        const loop = (t: number) => { paint(0.9 + t / 26000); raf = requestAnimationFrame(loop); };
        const start = () => { paint(0.9); if (!reduce) raf = requestAnimationFrame(loop); };
        if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start); else setTimeout(start, 0);
        window.addEventListener('resize', () => { if (reduce) paint(0.9); });
      });
    } catch (_) { /* never throw — generative art is decorative */ }
  })();
</script>
