---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap" style="gap: 0.5rem;">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}/`}
      class="tag-pill transition-colors"
      style="padding: 0.25rem 0.6rem; line-height: 1.4; display: inline-block;"
    >
      {tag}
    </a>
  ))}
</div>
