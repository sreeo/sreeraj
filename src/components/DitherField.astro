---
/* Generative signature: a procedural dither field rendered in
   block characters, value-noise seeded by the UTC date — the strip
   is different every day, identical for every visitor that day. */
---

<div class="dither" aria-hidden="true">
  <pre class="dither-pre wrap"></pre>
</div>

<script>
  const pre = document.querySelector<HTMLElement>('.dither-pre');
  if (pre) {
    const CHARS = [' ', '░', '▒', '▓', '█'];
    const ROWS = 7;
    const d = new Date();
    const seed = d.getUTCFullYear() * 416 + (d.getUTCMonth() + 1) * 32 + d.getUTCDate();

    const hash = (x: number, y: number): number => {
      let h = Math.imul(x, 374761393) ^ Math.imul(y, 668265263) ^ Math.imul(seed, 974634321);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
    };
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const noise = (x: number, y: number): number => {
      const xi = Math.floor(x), yi = Math.floor(y);
      const xf = smooth(x - xi), yf = smooth(y - yi);
      return lerp(
        lerp(hash(xi, yi), hash(xi + 1, yi), xf),
        lerp(hash(xi, yi + 1), hash(xi + 1, yi + 1), xf),
        yf
      );
    };

    let cols = 80;
    const measure = () => {
      const probe = document.createElement('span');
      probe.textContent = '█'.repeat(50);
      probe.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;';
      pre.appendChild(probe);
      const w = probe.getBoundingClientRect().width / 50 || 7.2;
      probe.remove();
      cols = Math.max(20, Math.floor((pre.clientWidth - 2) / w));
    };

    const draw = (t: number) => {
      let out = '';
      for (let y = 0; y < ROWS; y++) {
        for (let x = 0; x < cols; x++) {
          const v =
            0.65 * noise(x * 0.055 + t * 0.18, y * 0.24) +
            0.35 * noise(x * 0.16 - t * 0.11, y * 0.5 + t * 0.05);
          out += CHARS[Math.min(4, Math.floor(v * 5))];
        }
        out += '\n';
      }
      pre.textContent = out;
    };

    let t0 = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => {
      measure();
      draw(0);
      if (!reduce) setInterval(() => draw(++t0), 280);
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start);
    } else {
      setTimeout(start, 1);
    }
    window.addEventListener('resize', () => { measure(); draw(t0); }, { passive: true });
  }
</script>
