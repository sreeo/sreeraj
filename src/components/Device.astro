---
// The printer's device: Aldus's anchor-and-dolphin, redrawn so the dolphin
// coils around the shank as an S, flanked by SRE · RAJ as AL · DVS once was.
interface Props {
  class?: string;
  letters?: boolean;
  title?: string;
}
const { class: cls = '', letters = true, title } = Astro.props;
---

<svg
  class:list={['device', cls]}
  viewBox="-14 0 228 250"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  fill="none"
  stroke="currentColor"
>
  {title && <title>{title}</title>}
  <!-- ring and stock -->
  <circle cx="100" cy="22" r="11" stroke-width="5" />
  <path d="M56 54 H144" stroke-width="7" stroke-linecap="round" />
  <circle cx="54" cy="54" r="6" fill="currentColor" stroke="none" />
  <circle cx="146" cy="54" r="6" fill="currentColor" stroke="none" />
  <!-- shank -->
  <path d="M100 33 V210" stroke-width="7" />
  <!-- arms and flukes -->
  <path d="M38 168 C 44 208, 76 220, 100 220 C 124 220, 156 208, 162 168" stroke-width="7" stroke-linecap="round" />
  <path d="M38 168 l -9 15 l 21 -5 z M162 168 l 9 15 l -21 -5 z" fill="currentColor" stroke-width="2" stroke-linejoin="round" />
  <circle cx="100" cy="224" r="7" fill="currentColor" stroke="none" />
  <!-- the dolphin as an S -->
  <g class="device-ink">
    <path
      d="M72 74 C 104 62, 140 80, 128 104 C 118 124, 76 120, 72 142 C 68 164, 102 176, 132 166"
      stroke-width="11"
      stroke-linecap="round"
    />
    <path d="M128 166 l 16 -16 l -3 15 l 16 6 l -16 4 l 2 15 z" fill="currentColor" stroke="none" />
    <circle cx="70" cy="76" r="10" fill="currentColor" stroke="none" />
    <path d="M62 79 l -12 5 l 13 2 z" fill="currentColor" stroke="none" />
    <path d="M110 88 l 10 -14 l 4 12 z M84 128 l -12 8 l 13 3 z" fill="currentColor" stroke="none" />
  </g>
  <circle cx="68" cy="73" r="2.4" fill="var(--paper)" stroke="none" />
  {letters && (
    <g fill="currentColor" stroke="none" font-family="Cardo, 'EB Garamond', serif" font-size="24" letter-spacing="2" text-anchor="middle">
      <text x="30" y="128">SRE</text>
      <text x="170" y="128">RAJ</text>
    </g>
  )}
</svg>
