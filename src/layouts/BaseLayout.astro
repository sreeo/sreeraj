---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WoodcutInitial from '../components/WoodcutInitial.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  theme?: 'tech' | 'trek';
  section?: { label: string; href: string };
  runningTitle?: string;
  ground?: 'paper' | 'field';
}

const { title, description, image, theme = 'tech', section, runningTitle, ground = 'paper' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class:list={[ground === 'field' && 'ground-field']}>
    <a href="#main" class="skip-link">Skip to the text</a>
    <Header section={section} runningTitle={runningTitle} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WoodcutInitial />
  </body>
</html>
