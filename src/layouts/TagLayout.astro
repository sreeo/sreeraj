---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Device from '../components/Device.astro';
import { roman } from '../utils/roman';

interface Props {
  title: string;
  description?: string;
  liber?: string;
  rubric?: string;
  theme?: 'tech' | 'trek';
  posts: CollectionEntry<'blog'>[];
}

const { title, description, liber = 'Rubrica', rubric, theme = 'tech', posts } = Astro.props;

// Global chapter numbers, so a work is cap. xvii wherever it is listed.
const all = (await getCollection('blog')).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const numOf = (slug: string) => all.findIndex((p) => p.data.slug === slug) + 1;
const count = posts.length;
const NUMBER_WORDS = ['nulla', 'unus', 'duo', 'tres', 'quattuor', 'quinque', 'sex', 'septem', 'octo', 'novem', 'decem'];
const countWord = NUMBER_WORDS[count] ?? roman(count);
const years = posts.map((p) => p.data.pubDate.getUTCFullYear());
const span = years.length ? `${roman(Math.min(...years))}${Math.min(...years) !== Math.max(...years) ? ' – ' + roman(Math.max(...years)) : ''}` : '';
---

<BaseLayout
  title={`${title} — sreeraj.dev`}
  description={description}
  theme={theme}
  section={{ label: rubric ?? title, href: Astro.url.pathname }}
  runningTitle={liber}
>
  <div class="folio">
    <header class="page-head">
      <span class="liber sc">{liber}</span>
      <h1 class="page-title">{title}</h1>
      {description && (
        <div data-initial>
          <p class="page-description">{description}</p>
        </div>
      )}
      <span class="fleuron" aria-hidden="true">❧</span>
    </header>

    <aside class="marg head-note" aria-label="Contents of this book">
      <Device class="device" letters={false} />
      <strong>{count}</strong>
      Continentur tractatus {countWord} — {count === 1 ? 'one work' : `${count} works`} herein{span && `, printed ${span}`}.
    </aside>

    {count > 0 ? (
      <ol class="register wide" data-qa="post-list">
        {posts.map((post) => (
          <li>
            <PostCard
              variant="register"
              title={post.data.title}
              slug={post.data.slug}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              readingTime={post.data.readingTime}
              featureImage={post.data.featureImage}
              num={numOf(post.data.slug)}
            />
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-note" data-qa="post-list">Nothing has yet been printed under this rubric.</p>
    )}

    <p class="catchword">Finis libri.</p>
  </div>
</BaseLayout>
