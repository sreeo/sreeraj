---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { spanFor } from '../utils/spans';

interface Props {
  title: string;
  description?: string;
  paint?: 'red' | 'blue' | 'yellow' | 'ink';
  theme?: 'tech' | 'trek';
  posts: CollectionEntry<'blog'>[];
}

const { title, description, paint = 'red', theme = 'tech', posts } = Astro.props;

const paintCell = {
  red: 'cell--red',
  blue: 'cell--blue',
  yellow: 'cell--yellow',
  ink: 'cell--ink',
}[paint];
---

<BaseLayout title={`${title} — sreeraj.dev`} description={description} theme={theme}>
  <!-- title register -->
  <div class="band">
    <div class:list={['cell', 'label-cell', paintCell, 'c3']}>
      <span>section /</span>
    </div>
    <div class="cell c7">
      <h1 class="page-title">{title}</h1>
      <p class="section-sub">
        {posts.length} {posts.length === 1 ? 'composition' : 'compositions'}, newest first
        {description && ` — ${description}`}
      </p>
    </div>
    <div class="plane plane--yellow c2" aria-hidden="true"></div>
  </div>

  <!-- post composition -->
  {posts.length > 0 ? (
    <div class="band">
      {posts.map((post, i) => (
        <PostCard
          title={post.data.title}
          slug={post.data.slug}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={post.data.readingTime}
          num={String(posts.length - i).padStart(3, '0')}
          span={spanFor(i)}
          lead={i === 0}
        />
      ))}
    </div>
  ) : (
    <div class="band">
      <div class="cell c8">
        <p style="color: var(--muted); margin: 0;">nothing composed here yet.</p>
      </div>
      <div class="plane plane--red c4" aria-hidden="true"></div>
    </div>
  )}
</BaseLayout>
