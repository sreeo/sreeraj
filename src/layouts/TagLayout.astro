---
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

interface Post {
  data: {
    title: string;
    slug: string;
    description: string;
    pubDate: Date;
    tags: string[];
    readingTime: number;
    featured: boolean;
  };
}

interface Props {
  title: string;
  path: string;
  posts: Post[];
  note?: string;
  theme?: 'tech' | 'trek';
}

const { title, path, posts, note, theme = 'tech' } = Astro.props;
const total = posts.length;
const pad = (n: number) => String(n).padStart(3, '0');
---

<BaseLayout title={`${title} — sreeraj.dev`} description={note} theme={theme}>
  <section class="wrap section-tight">
    <nav class="crumbs" aria-label="Breadcrumb" style="margin-bottom: var(--s-5);">
      <a href="/">~</a>
      <span aria-hidden="true">/</span>
      <span>{path}</span>
    </nav>

    <div class="slab">
      <h1>INDEX OF /{path.toUpperCase()}</h1>
      <span class="slab-note">{total} {total === 1 ? 'FILE' : 'FILES'} · NEWEST FIRST</span>
    </div>

    {note && (
      <p style="margin-top: var(--s-4); max-width: 62ch; font-size: var(--t-md); line-height: 1.65; color: var(--muted);">{note}</p>
    )}

    {total > 0 ? (
      <div class="idx" style="margin-top: var(--s-5);">
        <div class="idx-cols" aria-hidden="true">
          <span>№</span>
          <span class="only-wide">Date</span>
          <span>Title</span>
          <span class="only-wide">Tags</span>
          <span style="text-align: right;">Min</span>
        </div>
        {posts.map((post, i) => (
          <PostCard
            title={post.data.title}
            slug={post.data.slug}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            readingTime={post.data.readingTime}
            featured={post.data.featured}
            num={pad(total - i)}
          />
        ))}
      </div>
    ) : (
      <div class="box" style="margin-top: var(--s-5); padding: var(--s-5); font-family: var(--font-mono); font-size: var(--t-sm);">
        0 FILES. NOTHING HERE YET.
      </div>
    )}
  </section>
</BaseLayout>
