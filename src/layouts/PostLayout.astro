---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface TrekStatsData {
  elevation?: string;
  distance?: string;
  duration?: string;
  difficulty?: string;
  basecamp?: string;
  season?: string;
  startAlt?: number;
  peakAlt?: number;
}

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  featureImage?: string;
  tags?: string[];
  author?: string;
  readingTime?: number;
  theme?: 'tech' | 'trek';
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  trekStats?: TrekStatsData;
}

const {
  title, slug, description, pubDate, updatedDate, featureImage,
  tags = [], author = 'Sreeraj', readingTime = 1, theme = 'tech',
  prevPost = null, nextPost = null, trekStats,
} = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const iso = (d: Date) => `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;

const SECTIONS: Array<{ label: string; href: string; match: string[] }> = [
  { label: 'treks', href: '/treks/', match: ['treks', 'trek'] },
  { label: 'devops', href: '/devops/', match: ['devops'] },
  { label: 'postgres', href: '/postgres/', match: ['postgres'] },
  { label: 'programming', href: '/programming/', match: ['programming'] },
];
const section = SECTIONS.find((s) => s.match.some((m) => tags.includes(m)));

const specRows: Array<[string, string]> = [
  ['date', iso(pubDate)],
  ...(updatedDate && updatedDate.getTime() !== pubDate.getTime()
    ? [['updated', iso(updatedDate)] as [string, string]]
    : []),
  ['author', author],
  ['read time', `${readingTime} min`],
  ...(trekStats
    ? ([
        ['elevation', trekStats.elevation],
        ['distance', trekStats.distance],
        ['duration', trekStats.duration],
        ['difficulty', trekStats.difficulty],
        ['basecamp', trekStats.basecamp],
        ['season', trekStats.season],
      ].filter(([, v]) => v) as Array<[string, string]>)
    : []),
];
---

<BaseLayout title={`${title} — sreeraj.dev`} description={description} image={featureImage} theme={theme}>
  <article class="wrap section-tight">
    <!-- Path -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">~</a>
      <span aria-hidden="true">/</span>
      {section && (
        <>
          <a href={section.href}>{section.label}</a>
          <span aria-hidden="true">/</span>
        </>
      )}
      <span>{slug}</span>
    </nav>

    <!-- Title block -->
    <header>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-lead">{description}</p>}

      <!-- Spec sheet -->
      <dl class="spec" style="margin-top: var(--s-5); max-width: 680px;">
        {specRows.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
        {tags.length > 0 && (
          <>
            <dt>tags</dt>
            <dd><TagList tags={tags} /></dd>
          </>
        )}
      </dl>
    </header>

    <!-- Figure -->
    {featureImage && (
      <figure class="fig" style="margin-top: var(--s-6); max-width: 820px;">
        <img src={featureImage} alt={title} />
        <figcaption>FIG. 01 — {title}</figcaption>
      </figure>
    )}

    <!-- Document body -->
    <div class="doc" style="margin-top: var(--s-7);">
      <slot />
    </div>

    <!-- Prev / next -->
    <nav class="pager" style="margin-top: var(--s-8); max-width: 820px;" aria-label="Adjacent posts">
      {prevPost ? (
        <a href={`/${prevPost.slug}/`} class="pager-cell">
          <span class="pager-label">&larr; Older</span>
          <span class="pager-title">{prevPost.title}</span>
        </a>
      ) : (
        <div><span class="end">— start of log —</span></div>
      )}
      {nextPost ? (
        <a href={`/${nextPost.slug}/`} class="pager-cell" style="text-align: right;">
          <span class="pager-label">Newer &rarr;</span>
          <span class="pager-title">{nextPost.title}</span>
        </a>
      ) : (
        <div style="text-align: right;"><span class="end">— end of log —</span></div>
      )}
    </nav>
  </article>
</BaseLayout>
