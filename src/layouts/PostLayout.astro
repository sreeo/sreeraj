---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { sectionFor } from '../utils/sections';

interface TrekStatsData {
  elevation?: string;
  distance?: string;
  duration?: string;
  difficulty?: string;
  basecamp?: string;
  season?: string;
  startAlt?: number;
  peakAlt?: number;
}

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  featureImage?: string;
  tags?: string[];
  author?: string;
  readingTime?: number;
  theme?: 'tech' | 'trek';
  num?: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  trekStats?: TrekStatsData;
}

const {
  title, slug, description, pubDate, updatedDate, featureImage,
  tags = [], author = 'Sreeraj', readingTime = 1, theme = 'tech',
  num, prevPost = null, nextPost = null, trekStats,
} = Astro.props;

const section = sectionFor(tags);
const showUpdated = updatedDate && updatedDate.getTime() !== pubDate.getTime();

const statRows: Array<[string, string]> = trekStats
  ? ([
      ['Elevation', trekStats.elevation],
      ['Distance', trekStats.distance],
      ['Duration', trekStats.duration],
      ['Difficulty', trekStats.difficulty],
      ['Basecamp', trekStats.basecamp],
      ['Season', trekStats.season],
    ].filter(([, v]) => v) as Array<[string, string]>)
  : [];
---

<BaseLayout title={`${title} — sreeraj.dev`} description={description} image={featureImage} theme={theme}>
  <div class="read-wedge" id="read-wedge" aria-hidden="true"></div>

  <article class="post">
    <header class="post-header">
      <div class="wrap post-header-grid">
        <div class="post-header-main">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="sep" aria-hidden="true">/</span>
            {section && (
              <>
                <a href={section.href}>{section.label}</a>
                <span class="sep" aria-hidden="true">/</span>
              </>
            )}
            <span>{num ? `Dispatch Nº ${num}` : slug}</span>
          </nav>
          <h1 class="post-header-title">{title}</h1>
          {description && <p class="page-description">{description}</p>}
        </div>

        <aside class="post-header-meta" aria-label="Post details">
          <dl>
            <dt>Printed</dt>
            <dd><FormattedDate date={pubDate} /></dd>
            {showUpdated && (
              <>
                <dt>Revised</dt>
                <dd><FormattedDate date={updatedDate} /></dd>
              </>
            )}
            <dt>By</dt>
            <dd>{author}</dd>
            <dt>Reading</dt>
            <dd>{readingTime} min</dd>
          </dl>
          {tags.length > 0 && <TagList tags={tags} />}
        </aside>
      </div>
    </header>

    {statRows.length > 0 && (
      <section class="trek-journal" aria-label="Expedition data">
        <div class="wrap trek-stats">
          {statRows.map(([k, v]) => (
            <div class="trek-stat">
              <span class="k">{k}</span>
              <span class="v">{v}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {featureImage && (
      <figure class="trek-hero-wrap montage montage--split" style={`--img:url('${featureImage}')`}>
        <img class="trek-hero post-hero-image" src={featureImage} alt="" loading="eager" decoding="async" />
      </figure>
    )}

    <div class="wrap">
      <div class:list={['prose', theme === 'trek' && 'trek-prose']}>
        <slot />
      </div>
    </div>

    <nav class="post-nav" aria-label="Adjacent dispatches">
      {prevPost ? (
        <a href={`/${prevPost.slug}/`} class="post-nav-link">
          <span class="post-nav-border">&larr; Older dispatch</span>
          <span class="post-nav-title">{prevPost.title}</span>
        </a>
      ) : (
        <div class="post-nav-empty">The first dispatch</div>
      )}
      {nextPost ? (
        <a href={`/${nextPost.slug}/`} class="post-nav-link">
          <span class="post-nav-border">Newer dispatch &rarr;</span>
          <span class="post-nav-title">{nextPost.title}</span>
        </a>
      ) : (
        <div class="post-nav-empty">The latest dispatch</div>
      )}
    </nav>
  </article>

  <script>
    // The reading wedge: a red bar that drives across the top as you read.
    const wedge = document.getElementById('read-wedge');
    if (wedge) {
      let ticking = false;
      const draw = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        wedge.style.setProperty('--p', String(max > 0 ? Math.min(1, h.scrollTop / max) : 0));
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(draw); }
      };
      draw();
      document.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }
  </script>
</BaseLayout>
